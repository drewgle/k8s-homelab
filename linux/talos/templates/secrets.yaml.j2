# Talos cluster secrets configuration
# This file contains generated secrets for the Talos cluster
# DO NOT commit this file to version control - use Ansible Vault or external secret management

# Machine configuration secrets
talos_machine_token: "{{ talos_machine_token }}"
talos_ca_crt: |
{{ talos_ca_crt | indent(2, True) }}
talos_ca_key: |
{{ talos_ca_key | indent(2, True) }}

# Cluster secrets
talos_cluster_id: "{{ talos_cluster_id }}"
talos_cluster_secret: "{{ talos_cluster_secret }}"
talos_bootstrap_token: "{{ talos_bootstrap_token }}"
talos_secretbox_key: "{{ talos_secretbox_key }}"

# Cluster CA certificates
talos_cluster_ca_crt: |
{{ talos_cluster_ca_crt | indent(2, True) }}
talos_cluster_ca_key: |
{{ talos_cluster_ca_key | indent(2, True) }}

# Aggregator CA certificates  
talos_aggregator_ca_crt: |
{{ talos_aggregator_ca_crt | indent(2, True) }}
talos_aggregator_ca_key: |
{{ talos_aggregator_ca_key | indent(2, True) }}

# etcd CA certificates
talos_etcd_ca_crt: |
{{ talos_etcd_ca_crt | indent(2, True) }}
talos_etcd_ca_key: |
{{ talos_etcd_ca_key | indent(2, True) }}

# Service account key
talos_service_account_key: |
{{ talos_service_account_key | indent(2, True) }}