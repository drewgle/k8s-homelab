{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboardTitle": "Renovate Runner Dependency Dashboard",
  "configMigration": true,
  "labels": [
    "{{depName}}",
    "{{updateType}}"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^infrastructure/linux/.+/versions\\.yaml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+) depName=(?<depName>[^\\s]+)( versioning=(?<versioning>[^\\s]+))?\\s+[A-Za-z0-9_]+: \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^infrastructure/linux/talos/templates/.*\\.yaml\\.j2$"
      ],
      "matchStrings": [
        "ghcr\\.io/siderolabs/installer:(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["siderolabs/talos"],
      "groupName": "talos",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["kubernetes/kubernetes"],
      "groupName": "kubernetes",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["patch"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    }
  ]
}
