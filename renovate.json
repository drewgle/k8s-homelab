{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboardTitle": "Renovate Runner Dependency Dashboard",
  "configMigration": true,
  "labels": [
    "{{depName}}",
    "{{updateType}}"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/linux/.+/versions\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+) depName=(?<depName>[^\\s]+)( versioning=(?<versioning>[^\\s]+))?( registryUrl=(?<registryUrl>[^\\s]+))?\\s+[A-Za-z0-9_]+: \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["siderolabs/talos"],
      "groupName": "talos",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Kubernetes minors must wait for a Talos release that targets them, so these are never automerged.",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["kubernetes/kubernetes"],
      "groupName": "kubernetes",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["patch"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    }
  ]
}
