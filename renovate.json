{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboardTitle": "Renovate Runner Dependency Dashboard",
  "configMigration": true,
  "labels": [
    "{{depName}}",
    "{{updateType}}"
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "^infrastructure/linux/talos/versions\.yaml$"
      ],
      "matchStrings": [
        "installer:\\s*\"(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": [
        "^infrastructure/linux/talos/templates/.*\.yaml\.j2$"
      ],
      "matchStrings": [
        "ghcr\\.io/siderolabs/installer:(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": [
        "^infrastructure/linux/talos/versions\\.yaml$"
      ],
      "matchStrings": [
        "version:\\s*\"(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases", 
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["siderolabs/talos"],
      "groupName": "talos",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["kubernetes/kubernetes"], 
      "groupName": "kubernetes",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ],
  "docker-compose": {
    "hostRules": [
      {
        "matchHost": "docker.io",
        "hostType": "docker",
        "concurrentRequestLimit": 2
      }
    ],
    "packageRules": [
      {
        "matchUpdateTypes": [
          "digest",
          "pinDigest",
          "lockFileMaintenance"
        ],
        "automerge": true
      },
      {
        "matchDatasources": [
          "docker"
        ],
        "pinDigests": true
      },
      {
        "matchPackageNames": "immich-app**",
        "groupName": "immich"
      },
      {
        "matchPackageNames": [
          "tensorchord/pgvecto-rs"
        ],
        "enabled": false
      },
      {
        "matchPackageNames": [
          "ghcr.io/hotio/**"
        ],
        "versionCompatibility": "^(?<compatibility>release-)(?<version>.+)$"
      },
      {
        "matchUpdateTypes": [
          "patch"
        ],
        "addLabels": [
          "patch"
        ],
        "automerge": true,
      },
      {
        "matchUpdateTypes": [
          "minor"
        ],
        "addLabels": [
          "minor"
        ],
        "automerge": false
      },
      {
        "matchUpdateTypes": [
          "major"
        ],
        "addLabels": [
          "major"
        ],
        "automerge": false
      }
    ]
  }
}