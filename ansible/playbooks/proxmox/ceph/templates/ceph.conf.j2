# Ceph configuration file
# Generated by Ansible for homelab cluster

[global]
    fsid = {{ ceph_cluster_uuid }}
    mon_initial_members = {{ mon_hosts | join(', ') }}
    mon_host = {% for host in mon_hosts %}{{ hostvars[host]['ansible_default_ipv4']['address'] }}{% if not loop.last %},{% endif %}{% endfor %}

    public_network = {{ public_network }}
    cluster_network = {{ cluster_network }}
    
    # Authentication
    auth_cluster_required = cephx
    auth_service_required = cephx
    auth_client_required = cephx
    
    # Logging
    log_file = /var/log/ceph/$cluster-$type.$id.log
    log_to_syslog = true
    
    # Performance tuning
    filestore_xattr_use_omap = true
    
    # Pool defaults
    osd_pool_default_size = 3
    osd_pool_default_min_size = 2
    osd_pool_default_pg_num = 128
    osd_pool_default_pgp_num = 128
    
    # Crush rules
    osd_crush_chooseleaf_type = 1

[mon]
    mon_allow_pool_delete = true
    
[mgr]
    mgr_modules = dashboard

[osd]
    osd_journal_size = 1024
    osd_mkfs_type = xfs
    osd_mkfs_options_xfs = -f -i size=2048
    osd_mount_options_xfs = noatime,largeio,inode64,swalloc
    
    # Performance
    filestore_op_threads = 8
    filestore_merge_threshold = 40
    filestore_split_multiple = 8
    
[client]
    rbd_cache = true
    rbd_cache_writethrough_until_flush = true
    rbd_concurrent_management_ops = 20