# Ignition configuration for Flatcar Container Linux control plane nodes
# This template is processed by Ansible using variables from vars.yml

variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - {{ lookup('url', 'https://github.com/' + github_username + '.keys', split_lines=False) }}
      groups:
        - docker
        - wheel

storage:
  directories:
    - path: /etc/kubernetes
      mode: 0755
    - path: /etc/kubernetes/manifests
      mode: 0755
    - path: /etc/kubernetes/pki
      mode: 0700
    - path: /var/lib/kubelet
      mode: 0755
    - path: /opt/bin
      mode: 0755

  files:
    # containerd configuration
    - path: /etc/containerd/config.toml
      mode: 0644
      contents:
        inline: |
          version = 2
          root = "/var/lib/containerd"
          state = "/run/containerd"

          [grpc]
            address = "/run/containerd/containerd.sock"
            uid = 0
            gid = 0

          [plugins."io.containerd.grpc.v1.cri"]
            sandbox_image = "registry.k8s.io/pause:3.9"

          [plugins."io.containerd.grpc.v1.cri".containerd]
            snapshotter = "overlayfs"
            default_runtime_name = "runc"

          [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
            runtime_type = "io.containerd.runc.v2"

          [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
            SystemdCgroup = true

          [plugins."io.containerd.grpc.v1.cri".cni]
            bin_dir = "/opt/cni/bin"
            conf_dir = "/etc/cni/net.d"

    # kubelet configuration
    - path: /var/lib/kubelet/config.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: kubelet.config.k8s.io/v1beta1
          kind: KubeletConfiguration
          authentication:
            anonymous:
              enabled: false
            webhook:
              enabled: true
            x509:
              clientCAFile: /etc/kubernetes/pki/ca.crt
          authorization:
            mode: Webhook
          cgroupDriver: systemd
          clusterDNS:
            - {{ flatcar_cluster_dns }}
          clusterDomain: {{ kubernetes_dns_domain }}
          cpuManagerReconcilePeriod: 0s
          evictionPressureTransitionPeriod: 0s
          fileCheckFrequency: 0s
          healthzBindAddress: 127.0.0.1
          healthzPort: 10248
          httpCheckFrequency: 0s
          imageMinimumGCAge: 0s
          nodeStatusReportFrequency: 0s
          nodeStatusUpdateFrequency: 0s
          rotateCertificates: true
          runtimeRequestTimeout: 0s
          staticPodPath: /etc/kubernetes/manifests
          streamingConnectionIdleTimeout: 0s
          syncFrequency: 0s
          volumeStatsAggPeriod: 0s

{% if flatcar_vip is defined %}
    # kube-vip: holds the control plane VIP so losing one control plane does
    # not take the API away from every client (spec 0016, CNI-09). Talos does
    # this with a single vip.ip stanza; kubeadm needs a component.
    #
    # This references admin.conf, which is the steady state. kubeadm >= 1.29
    # does not create a usable admin.conf until after `kubeadm init`, so
    # 02-cluster-bootstrap.yml points this at super-admin.conf for the
    # duration of init on the first control plane and switches it back after.
    - path: /etc/kubernetes/manifests/kube-vip.yaml
      mode: 0600
      contents:
        inline: |
          apiVersion: v1
          kind: Pod
          metadata:
            name: kube-vip
            namespace: kube-system
          spec:
            hostNetwork: true
            containers:
              - name: kube-vip
                image: ghcr.io/kube-vip/kube-vip:{{ versions.kube_vip.version }}
                imagePullPolicy: IfNotPresent
                args: ["manager"]
                env:
                  - name: address
                    value: "{{ flatcar_vip }}"
                  - name: port
                    value: "6443"
                  - name: vip_arp
                    value: "true"
                  - name: vip_interface
                    value: "{{ flatcar_vip_interface | default('eth0') }}"
                  - name: vip_subnet
                    value: "32"
                  - name: cp_enable
                    value: "true"
                  - name: cp_namespace
                    value: kube-system
                  - name: vip_ddns
                    value: "false"
                  # MetalLB owns Service load balancing (spec 0009); kube-vip
                  # only holds the control plane address.
                  - name: svc_enable
                    value: "false"
                  - name: vip_leaderelection
                    value: "true"
                  - name: vip_leaseduration
                    value: "5"
                  - name: vip_renewdeadline
                    value: "3"
                  - name: vip_retryperiod
                    value: "1"
                securityContext:
                  capabilities:
                    add: ["NET_ADMIN", "NET_RAW", "SYS_TIME"]
                volumeMounts:
                  - mountPath: /etc/kubernetes/admin.conf
                    name: kubeconfig
            hostAliases:
              - hostnames:
                  - kubernetes
                ip: 127.0.0.1
            volumes:
              - name: kubeconfig
                hostPath:
                  path: /etc/kubernetes/admin.conf

{% endif %}
    # kubeadm configuration
    - path: /etc/kubernetes/kubeadm-config.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: kubeadm.k8s.io/v1beta3
          kind: ClusterConfiguration
          kubernetesVersion: {{ kubernetes_version }}
          # kubeadm wants host:port here, not a URL — the scheme is stripped.
          controlPlaneEndpoint: {{ flatcar_cluster_endpoint | regex_replace('^https?://', '') }}
          networking:
            podSubnet: {{ flatcar_pod_subnet }}
            serviceSubnet: {{ flatcar_service_subnet }}
          dns:
            type: CoreDNS
          etcd:
            local:
              dataDir: /var/lib/etcd
          apiServer:
            bindPort: 6443
            certSANs:
{% for host in groups['flatcar_controlplane'] %}
              - {{ hostvars[host]['ansible_host'] }}
              - {{ host }}
{% endfor %}
              - {{ flatcar_cluster_endpoint | regex_replace('^https?://') | regex_replace(':.*$') }}
          controllerManager: {}
          scheduler: {}
          ---
          apiVersion: kubeadm.k8s.io/v1beta3
          kind: InitConfiguration
          localAPIEndpoint:
            advertiseAddress: {{ node_ip }}
            bindPort: 6443
          nodeRegistration:
            kubeletExtraArgs:
              cloud-provider: external
            criSocket: unix:///run/containerd/containerd.sock

systemd:
  units:
    - name: containerd.service
      enabled: true

    - name: kubelet.service
      enabled: true
      contents: |
        [Unit]
        Description=kubelet: The Kubernetes Node Agent
        Documentation=https://kubernetes.io/docs/
        Wants=network-online.target
        After=network-online.target

        [Service]
        ExecStart=/opt/bin/kubelet \
          --config=/var/lib/kubelet/config.yaml \
          --kubeconfig=/etc/kubernetes/kubelet.conf \
          --container-runtime-endpoint=unix:///run/containerd/containerd.sock \
          --pod-infra-container-image=registry.k8s.io/pause:3.9 \
          --node-ip={{ node_ip }} \
          --v=2
        Restart=always
        StartLimitInterval=0
        RestartSec=10

        [Install]
        WantedBy=multi-user.target

    - name: setup-kubernetes.service
      enabled: true
      contents: |
        [Unit]
        Description=Setup Kubernetes binaries
        Wants=network-online.target
        After=network-online.target
        ConditionPathExists=!/opt/bin/kubelet

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c '
          cd /tmp && \
          curl -L --remote-name-all https://dl.k8s.io/release/{{ kubernetes_version }}/bin/linux/amd64/{kubeadm,kubelet,kubectl} && \
          chmod +x {kubeadm,kubelet,kubectl} && \
          mv {kubeadm,kubelet,kubectl} /opt/bin/'
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    - name: disable-update-engine.service
      enabled: false
      mask: true

    - name: locksmithd.service
      enabled: false
      mask: true