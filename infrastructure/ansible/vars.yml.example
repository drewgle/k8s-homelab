# Homelab Configuration Variables
# Copy this file to vars.yml and customize the values for your environment

# GitHub username to fetch SSH keys from
github_username: "your-github-username"

# Proxmox cluster configuration
proxmox_cluster_name: "homelab"              # Name for your Proxmox cluster
# proxmox_cluster_network: "192.168.1.0/24"  # Optional: specific cluster network

# Hosts allowed to manage the nodes (SSH, web UI, consoles, live migration).
# Populates the Proxmox firewall's "management" IPSet; every inventory node is
# added automatically. Set this if you administer from a different subnet —
# a host outside this list loses SSH and web UI access once harden.yml runs.
firewall_management_sources:
  - "192.168.1.0/24"

# Ceph cluster configuration
ceph_public_network: "192.168.1.0/24"    # Network for client communications
ceph_cluster_network: "10.0.1.0/24"      # Network for cluster communications (optional, can be same as public)

# Kubernetes configuration
kubernetes_dns_domain: "cluster.local"                        # Kubernetes cluster DNS domain
kubernetes_cni: "cilium"                                      # CNI: cilium (see spec 0016) or flannel
kubernetes_install_disk: "/dev/sda"                           # Disk for OS installation
# kubernetes_network_interface: "eth0"                         # Optional: specific network interface

# Node IPs live in inventory.yaml. The cluster endpoint is a floating VIP, not
# a node address: the endpoint is baked into the PKI and every kubeconfig, so
# pointing it at one node means three control planes buy quorum and nothing
# else (spec 0016, CNI-09). The VIP must be free, on the VM VLAN, and outside
# the MetalLB pool.
talos_cluster_name: "talos-homelab"
talos_vip: "192.168.100.200"                                  # Elected via etcd by Talos itself
talos_cluster_endpoint: "https://192.168.100.200:6443"
talos_pod_subnet: "10.244.0.0/16"
talos_service_subnet: "10.96.0.0/12"                          # Covers 10.96-10.111
talos_cluster_dns: "10.96.0.10"

# VM provisioning on Proxmox
vm_vlan_id: 100                                               # VLAN ID for VM network isolation
vm_bridge_name: "vmbr1"                                       # Proxmox bridge for VMs
vm_gateway: "192.168.100.1"                                   # Gateway IP for VM VLAN
vm_subnet: "192.168.100.0/24"                                 # VM network CIDR (kubelet node IP subnet)
vm_cidr_bits: "24"                                           # Network CIDR bits (e.g., /24)
vm_storage: "local-lvm"                                       # Proxmox storage for VM disks

# VM specifications. Workers carry the workloads, so they get the
# cores; control planes are mostly etcd and API server and stay small.
vm_cp_cores: 2                                               # CPU cores for control plane VMs
vm_cp_memory: 4096                                           # Memory (MB) for control plane VMs
vm_cp_disk_size: "50G"                                       # Disk size for control plane VMs
vm_worker_cores: 4                                           # CPU cores for worker VMs
vm_worker_memory: 8192                                       # Memory (MB) for worker VMs
vm_worker_disk_size: "100G"                                  # Disk size for worker VMs

# Proxmox bare-metal auto-install (see infrastructure/linux/proxmox/README.md)
mgmt_gateway: "192.168.1.1"                                   # Gateway for the management network
mgmt_cidr_bits: "24"                                          # CIDR bits for node management IPs
root_mailto: "you@example.com"                                # Root mail target in the installer answer
pve_country: "us"                                             # Installer locale settings
pve_keyboard: "en-us"

# DNS and NTP configuration
dns_servers:
  - "1.1.1.1"
  - "8.8.8.8"
ntp_servers:
  - "pool.ntp.org"
  - "time.google.com"
  
timezone: "America/New_York"
domain_name: "homelab.local"
